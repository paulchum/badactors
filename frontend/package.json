{
  "name": "badactors-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "feeds": "cd .. && uv run python scripts/export_feeds.py",
    "bench": "cd .. && uv run python scripts/export_bench.py",
    "predev": "npm run feeds && npm run bench",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run feeds && npm run bench",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4",
    "typescript": "^7.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "postcss": "^8.5.0",
    "autoprefixer": "^10.6.1",
    "vitest": "^5.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
