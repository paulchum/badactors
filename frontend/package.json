{
  "name": "badactors-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "feeds": "cd .. && uv run python scripts/export_feeds.py",
    "predev": "npm run feeds",
    "dev": "vite --host 127.0.0.1",
