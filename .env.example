# Copy to .env and fill in what you need. .env is git-ignored.
# Nothing reads this file by itself: load it with `uv run --env-file .env ...`
# or your shell. Everything except real model runs works with it empty.

# OpenRouter key for castle-live and castle-qualify. Only read from the
# environment, never printed, logged or saved.
OPENROUTER_API_KEY=

# Set this to let the API answer anything other than 127.0.0.1. Every request
# except /health then needs it as a bearer token.
BADACTORS_API_TOKEN=

# Site build settings. Vite reads these from frontend/.env, not this file.
# VITE_TALLY_URL=        POST {"puzzle","pick"}, answers {"picks":{id:count}}
# VITE_REPO_URL=https://github.com/paulchum/badactors
# VITE_LEADERBOARD_URL=
